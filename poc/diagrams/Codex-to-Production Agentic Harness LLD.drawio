<mxCell id="t62" value="&lt;b&gt;Harness run loop&lt;/b&gt; · Cloud Workflows, 9 steps&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;try / retry with backoff · callbacks for every gate&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;fontColor=#000000;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1566" y="346" width="380" height="52" as="geometry"/></mxCell>
<mxCell id="b63" value="&lt;b&gt;01 Understand&lt;/b&gt; · Requirements Agent → brief.json" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0FAFE;strokeColor=#0097AD;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1590" y="410" width="350" height="56" as="geometry"/></mxCell>
<mxCell id="b64" value="&lt;b&gt;H1&lt;/b&gt; · product owner / business lead" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFD700;strokeColor=#FFD700;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1590" y="476" width="350" height="40" as="geometry"/></mxCell>
<mxCell id="b65" value="&lt;b&gt;02 Design&lt;/b&gt; · Architect Agent → design.json, Confluence draft" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0FAFE;strokeColor=#0097AD;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1590" y="526" width="350" height="56" as="geometry"/></mxCell>
<mxCell id="b66" value="&lt;b&gt;Change Guardian&lt;/b&gt; · design check, names affected pods" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFE6F0;strokeColor=#FF0069;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1590" y="592" width="350" height="56" as="geometry"/></mxCell>
<mxCell id="b67" value="&lt;b&gt;H2&lt;/b&gt; · architect + affected pod owners" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFD700;strokeColor=#FFD700;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1590" y="658" width="350" height="40" as="geometry"/></mxCell>
<mxCell id="b68" value="&lt;b&gt;03 Build&lt;/b&gt; · Developer Agent (worker Codex) → PR + SHA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0FAFE;strokeColor=#0097AD;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1590" y="708" width="350" height="56" as="geometry"/></mxCell>
