<mxCell id="t24" value="&lt;b&gt;Systems of record&lt;/b&gt; · read-only, authority stays with each system" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;fontColor=#000000;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1056" y="200" width="700" height="30" as="geometry"/></mxCell>
<mxCell id="b25" value="&lt;b&gt;Jira Cloud&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#595959'&gt;stories, acceptance criteria&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1056" y="236" width="228" height="50" as="geometry"/></mxCell>
<mxCell id="b26" value="&lt;b&gt;Confluence&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#595959'&gt;designs, business rules&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1297" y="236" width="228" height="50" as="geometry"/></mxCell>
<mxCell id="b27" value="&lt;b&gt;Salesforce&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#595959'&gt;Health, Data, Marketing Cloud metadata&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1538" y="236" width="228" height="50" as="geometry"/></mxCell>
<mxCell id="b28" value="&lt;b&gt;Git&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#595959'&gt;Apex, LWC, metadata, tests&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1056" y="294" width="228" height="50" as="geometry"/></mxCell>
<mxCell id="b29" value="&lt;b&gt;Copado&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#595959'&gt;promotions, test runs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1297" y="294" width="228" height="50" as="geometry"/></mxCell>
<mxCell id="b30" value="&lt;b&gt;Google Drive&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#595959'&gt;specs, mapping sheets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1538" y="294" width="228" height="50" as="geometry"/></mxCell>
<mxCell id="b31" value="&lt;b&gt;Cloud Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;cron per source: Jira 15 min · Confluence 1 h · Copado 15 min · Drive 30 min · Salesforce nightly&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F3F6F8;strokeColor=#00273B;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="386" width="310" height="92" as="geometry"/></mxCell>
<mxCell id="b32" value="&lt;b&gt;Eventarc + Pub/Sub&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;Jira, Git, Copado webhooks start a sync early&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F3F6F8;strokeColor=#00273B;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1470" y="386" width="310" height="92" as="geometry"/></mxCell>
<mxCell id="b33" value="&lt;b&gt;Connector jobs · Cloud Run Jobs (Python 3.12)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;read-only auth: Atlassian token / OAuth · Salesforce JWT bearer (External Client App) · Git deploy key · Copado API user · Drive service account&lt;br&gt;delta since last high-water mark, kept in &lt;b&gt;Firestore&lt;/b&gt; · Salesforce flows read in chained batches (one Flow body per Tooling API call)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F3F6F8;strokeColor=#00273B;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="510" width="740" height="112" as="geometry"/></mxCell>
<mxCell id="b34" value="&lt;b&gt;Cloud Storage · raw artifacts&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;raw/&amp;lt;source&amp;gt;/&amp;lt;id&amp;gt;/&amp;lt;sha256&amp;gt;&lt;br&gt;versioned · CMEK · unchanged hash skipped&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F3F6F8;strokeColor=#00273B;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="654" width="350" height="92" as="geometry"/></mxCell>
<mxCell id="b35" value="&lt;b&gt;Sensitive Data Protection (DLP)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;de-identify Jira, Confluence and Drive text before parsing; Salesforce read as metadata only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFE6F0;strokeColor=#FF0069;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1430" y="654" width="350" height="92" as="geometry"/></mxCell>
<mxCell id="b36" value="&lt;b&gt;Ingest · validate · link · Cloud Run Jobs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;parsers: Jira ADF → Given/When/Then · Confluence HTML → rules · Flow XML · Apex SOQL/DML · test → class map&lt;br&gt;pydantic + JSON Schema · failures quarantined · unproven links stored as INFERRED (confidence &amp;lt; 1.0)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F3F6F8;strokeColor=#00273B;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="778" width="740" height="112" as="geometry"/></mxCell>
<mxCell id="b37" value="&lt;b&gt;JSON snapshot · Cloud Storage&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;snapshotId · nodes · relationships · provenance&lt;br&gt;vendor-neutral contract (deck layers 4 to 6)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F3F6F8;strokeColor=#00273B;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="922" width="350" height="112" as="geometry"/></mxCell>
<mxCell id="b38" value="&lt;b&gt;Spanner Graph (Enterprise)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;Node + Edge tables · CREATE PROPERTY GRAPH&lt;br&gt;valid_from / valid_to history · ownership edges&lt;br&gt;ISO GQL · full-text + vector search&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ECE9F5;strokeColor=#4527A0;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1430" y="922" width="350" height="150" as="geometry"/></mxCell>
<mxCell id="b39" value="&lt;b&gt;Graph API + MCP server · FastAPI on Cloud Run&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;private ingress · Google-signed identity tokens · agents never write GQL&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Courier New' style='font-size:13px'&gt;graph.exists &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;graph.find_reuse &amp;nbsp;&amp;nbsp;graph.blast_radius&lt;br&gt;graph.classify_risk graph.owners &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;graph.coverage_gap&lt;br&gt;graph.provenance &amp;nbsp;&amp;nbsp;graph.context_slice&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ECE9F5;strokeColor=#4527A0;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1040" y="1104" width="740" height="196" as="geometry"/></mxCell>
<mxCell id="b40" value="&lt;font color='#8C8C8C'&gt;-- GQL behind graph.blast_radius (illustrative)&lt;/font&gt;&lt;br&gt;GRAPH DeliveryGraph&lt;br&gt;MATCH (a)-[e:FLOW_UPDATES_SOBJECT|TRIGGER_FIRES_ON_SOBJECT]-&amp;gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(o:SOBJECT {api_name: 'HealthcareFacility'})&lt;br&gt;RETURN a.name, a.owner_pod, e.source_path" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#0D1117;strokeColor=#3A3A3A;fontColor=#E6E6E6;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacing=10;strokeWidth=1.5;fontFamily=Courier New;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1040" y="1332" width="740" height="160" as="geometry"/></mxCell>
<mxCell id="b41" value="&lt;b&gt;Trust built in&lt;/b&gt;&lt;br&gt;• Every answer cites node id, source path, SHA-256, snapshotId&lt;br&gt;• Existence is a full lookup, never a sample&lt;br&gt;• Freshness + coverage per source on Cloud Monitoring&lt;br&gt;• Sandbox POC today: 2,177 nodes · 2,786 edges (Salesforce)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontColor=#000000;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="1524" width="740" height="162" as="geometry"/></mxCell>
<mxCell id="e42" value="read-only APIs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#00273B;strokeWidth=2;fontSize=12;fontColor=#00273B;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="b23" target="b33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
