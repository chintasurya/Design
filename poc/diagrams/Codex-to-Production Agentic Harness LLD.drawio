<mxCell id="b72" value="&lt;b&gt;H4&lt;/b&gt; · business UAT (step 06)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFD700;strokeColor=#FFD700;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1590" y="956" width="350" height="40" as="geometry"/></mxCell>
