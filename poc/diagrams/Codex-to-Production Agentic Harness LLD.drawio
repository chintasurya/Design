<mxCell id="b83" value="&lt;b&gt;Harness approvals · Cloud Run + IAP&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;Ascension SSO · shows the evidence for that gate · decision signed with Cloud KMS, bound to run, scope, commit SHA and target · resumes the run through its Workflows callback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF7CC;strokeColor=#C9A800;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1870" y="1362" width="410" height="150" as="geometry"/></mxCell>
<mxCell id="b84" value="&lt;b&gt;Evaluation + learning loop&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;no model trained on our data · step 09 resyncs the graph · incidents become Guardian rules · rejected outputs become evaluation cases that run in Cloud Build before any prompt or model change&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#EAFBE6;strokeColor=#2E9E1F;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1870" y="1544" width="410" height="142" as="geometry"/></mxCell>
<mxCell id="b85" value="&lt;b&gt;Harness dispatcher · Cloud Run&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;starts one Cloud Run Job per step with: runId, step, agent, skills, identity, inputs, allowedTools, budget, outputSchema&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F3F6F8;strokeColor=#00273B;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2320" y="340" width="330" height="112" as="geometry"/></mxCell>
<mxCell id="b86" value="&lt;b&gt;Pub/Sub&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;step.completed / step.failed&lt;br&gt;output validated against its schema, then a checkpoint · dead-letter topic + alert&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F3F6F8;strokeColor=#00273B;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2670" y="340" width="330" height="112" as="geometry"/></mxCell>
<mxCell id="b87" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#0097AD;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2320" y="484" width="680" height="520" as="geometry"/></mxCell>
<mxCell id="t88" value="&lt;b&gt;Agent workers · Cloud Run Jobs&lt;/b&gt; &lt;font style='font-size:12px' color='#595959'&gt;· images in Artifact Registry · run once, then exit&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;fontColor=#000000;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2336" y="490" width="650" height="40" as="geometry"/></mxCell>
<mxCell id="b89" value="&lt;b&gt;Requirements Agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#0097AD'&gt;OpenAI Agents SDK (Python) · sa-ai-read&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;Jira story + graph.context_slice → acceptance criteria (Given/When/Then), open questions, every line cited&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0FAFE;strokeColor=#0097AD;fontColor=#000000;fontSize=14;fontStyle=0;align=left;verticalAlign=top;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2336" y="538" width="316" height="140" as="geometry"/></mxCell>
<mxCell id="b90" value="&lt;b&gt;Architect Agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#0097AD'&gt;Agents SDK · sa-ai-read&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;exists → find_reuse → blast_radius → owners → classify_risk → coverage_gap → design.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0FAFE;strokeColor=#0097AD;fontColor=#000000;fontSize=14;fontStyle=0;align=left;verticalAlign=top;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2668" y="538" width="316" height="140" as="geometry"/></mxCell>
<mxCell id="b91" value="&lt;b&gt;Developer Agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#0097AD'&gt;worker Codex (Codex SDK / codex exec) · sa-ai-dev&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;branch mad/&amp;lt;story&amp;gt; · sf project deploy (DEV sandbox only) · sf apex run test · Code Analyzer · loop until green → PR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0FAFE;strokeColor=#0097AD;fontColor=#000000;fontSize=14;fontStyle=0;align=left;verticalAlign=top;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2336" y="690" width="316" height="140" as="geometry"/></mxCell>
<mxCell id="b92" value="&lt;b&gt;Review Agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#0097AD'&gt;Agents SDK + Code Analyzer (PMD), ESLint · sa-ai-read&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;standards, security, access checks → findings.json + PR comments · cannot approve&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0FAFE;strokeColor=#0097AD;fontColor=#000000;fontSize=14;fontStyle=0;align=left;verticalAlign=top;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2668" y="690" width="316" height="140" as="geometry"/></mxCell>
<mxCell id="b93" value="&lt;b&gt;Test Agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#0097AD'&gt;worker Codex + Agents SDK · sa-ai-dev&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;Apex + Jest tests from the design · Zephyr Scale cases · regression scope from blast_radius&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0FAFE;strokeColor=#0097AD;fontColor=#000000;fontSize=14;fontStyle=0;align=left;verticalAlign=top;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2336" y="842" width="316" height="140" as="geometry"/></mxCell>
<mxCell id="b94" value="&lt;b&gt;Release Agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#0097AD'&gt;Agents SDK · sa-ai-release&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;Copado API: user story, promote SIT then UAT · manifest, rollback plan, CAB pack&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0FAFE;strokeColor=#0097AD;fontColor=#000000;fontSize=14;fontStyle=0;align=left;verticalAlign=top;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2668" y="842" width="316" height="140" as="geometry"/></mxCell>
<mxCell id="b95" value="&lt;b&gt;Approved model endpoint&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;OpenAI API through Secure Web Proxy allowlist · bounded, redacted context only · BAA / zero retention per Ascension terms&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F3F6F8;strokeColor=#00273B;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2320" y="1036" width="330" height="112" as="geometry"/></mxCell>
