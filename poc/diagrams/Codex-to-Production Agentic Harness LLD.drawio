<mxCell id="b22" value="3 · PHASE 2 · AGENTIC HARNESS RUNTIME  (Google Cloud)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#00273B;strokeColor=#00273B;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1520" y="140" width="1180" height="44" as="geometry"/></mxCell>
