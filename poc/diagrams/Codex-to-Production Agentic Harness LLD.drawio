<mxCell id="b58" value="&lt;b&gt;Change Guardian&lt;/b&gt; · design check, names affected pods" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFE6F0;strokeColor=#FF0069;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1910" y="592" width="350" height="56" as="geometry"/></mxCell>
