<mxCell id="b59" value="&lt;b&gt;Harness entry · Run API · Cloud Run&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;validates the story · idempotency key = story + revision · creates the run · starts one Workflows execution&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F3F6F8;strokeColor=#00273B;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1550" y="196" width="410" height="112" as="geometry"/></mxCell>
<mxCell id="b60" value="&lt;b&gt;Harness state · Firestore runs/{runId}&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;current step · status · attempts · minutes and token budget · artifact URIs · commit SHA · approval ids · checkpoints&lt;br&gt;a run can be inspected or resumed from this document alone&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F3F6F8;strokeColor=#00273B;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2000" y="196" width="680" height="112" as="geometry"/></mxCell>
