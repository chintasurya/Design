<mxCell id="b91" value="&lt;b&gt;Harness approvals · Cloud Run + IAP&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;Ascension SSO · shows the evidence for that gate · decision signed with Cloud KMS, bound to run, scope, commit SHA and target · resumes the run through its Workflows callback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF7CC;strokeColor=#C9A800;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1550" y="1362" width="410" height="150" as="geometry"/></mxCell>
<mxCell id="b92" value="&lt;b&gt;Evaluation + learning loop&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;no model trained on our data · step 09 resyncs the graph · incidents become Guardian rules · rejected outputs become evaluation cases that run in Cloud Build before any prompt or model change&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#EAFBE6;strokeColor=#2E9E1F;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1550" y="1544" width="410" height="142" as="geometry"/></mxCell>
<mxCell id="b93" value="&lt;b&gt;Harness dispatcher · Cloud Run&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;starts one Cloud Run Job per step with: runId, step, agent, skills, identity, inputs, allowedTools, budget, outputSchema&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F3F6F8;strokeColor=#00273B;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2000" y="340" width="330" height="112" as="geometry"/></mxCell>
<mxCell id="b94" value="&lt;b&gt;Pub/Sub&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;step.completed / step.failed&lt;br&gt;output validated against its schema, then a checkpoint · dead-letter topic + alert&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F3F6F8;strokeColor=#00273B;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2350" y="340" width="330" height="112" as="geometry"/></mxCell>
<mxCell id="b95" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#0097AD;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2000" y="484" width="680" height="520" as="geometry"/></mxCell>
<mxCell id="t96" value="&lt;b&gt;Agent workers · Cloud Run Jobs&lt;/b&gt; &lt;font style='font-size:12px' color='#595959'&gt;· images in Artifact Registry · run once, then exit&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;fontColor=#000000;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2016" y="490" width="650" height="40" as="geometry"/></mxCell>
<mxCell id="b97" value="&lt;b&gt;Requirements Agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#0097AD'&gt;OpenAI Agents SDK (Python) · sa-ai-read&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;Jira story + graph.context_slice → acceptance criteria (Given/When/Then), open questions, every line cited&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0FAFE;strokeColor=#0097AD;fontColor=#000000;fontSize=14;fontStyle=0;align=left;verticalAlign=top;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2016" y="538" width="316" height="140" as="geometry"/></mxCell>
<mxCell id="b98" value="&lt;b&gt;Architect Agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#0097AD'&gt;Agents SDK · sa-ai-read&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;exists → find_reuse → blast_radius → owners → classify_risk → coverage_gap → design.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0FAFE;strokeColor=#0097AD;fontColor=#000000;fontSize=14;fontStyle=0;align=left;verticalAlign=top;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2348" y="538" width="316" height="140" as="geometry"/></mxCell>
<mxCell id="b99" value="&lt;b&gt;Developer Agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#0097AD'&gt;worker Codex (Codex SDK / codex exec) · sa-ai-dev&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;branch mad/&amp;lt;story&amp;gt; · sf project deploy (DEV sandbox only) · sf apex run test · Code Analyzer · loop until green → PR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0FAFE;strokeColor=#0097AD;fontColor=#000000;fontSize=14;fontStyle=0;align=left;verticalAlign=top;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2016" y="690" width="316" height="140" as="geometry"/></mxCell>
<mxCell id="b100" value="&lt;b&gt;Review Agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#0097AD'&gt;Agents SDK + Code Analyzer (PMD), ESLint · sa-ai-read&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;standards, security, access checks → findings.json + PR comments · cannot approve&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0FAFE;strokeColor=#0097AD;fontColor=#000000;fontSize=14;fontStyle=0;align=left;verticalAlign=top;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2348" y="690" width="316" height="140" as="geometry"/></mxCell>
<mxCell id="b101" value="&lt;b&gt;Test Agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#0097AD'&gt;worker Codex + Agents SDK · sa-ai-dev&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;Apex + Jest tests from the design · Zephyr Scale cases · regression scope from blast_radius&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0FAFE;strokeColor=#0097AD;fontColor=#000000;fontSize=14;fontStyle=0;align=left;verticalAlign=top;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2016" y="842" width="316" height="140" as="geometry"/></mxCell>
<mxCell id="b102" value="&lt;b&gt;Release Agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#0097AD'&gt;Agents SDK · sa-ai-release&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;Copado API: user story, promote SIT then UAT · manifest, rollback plan, CAB pack&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0FAFE;strokeColor=#0097AD;fontColor=#000000;fontSize=14;fontStyle=0;align=left;verticalAlign=top;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2348" y="842" width="316" height="140" as="geometry"/></mxCell>
<mxCell id="b103" value="&lt;b&gt;Approved model endpoint&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;OpenAI API through Secure Web Proxy allowlist · bounded, redacted context only · BAA / zero retention per Ascension terms&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F3F6F8;strokeColor=#00273B;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2000" y="1036" width="330" height="112" as="geometry"/></mxCell>
<mxCell id="b104" value="&lt;b&gt;Change Guardian · Cloud Run + OPA&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;diff + ownership graph + Rego rulebook → PASS / NEEDS OWNER APPROVAL / BLOCK · design, every commit, promotion, nightly drift&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFE6F0;strokeColor=#FF0069;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2350" y="1036" width="330" height="112" as="geometry"/></mxCell>
<mxCell id="b105" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFE6F0;strokeColor=#FF0069;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2000" y="1180" width="680" height="196" as="geometry"/></mxCell>
<mxCell id="t106" value="&lt;b&gt;Harness tool gateway · MCP · Cloud Run + Open Policy Agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;checks identity · tool · target · approval for the current SHA → runs the action with that identity's credential from Secret Manager → logs the decision to BigQuery&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;fontColor=#000000;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2016" y="1186" width="650" height="64" as="geometry"/></mxCell>
<mxCell id="b107" value="&lt;b&gt;sa-ai-read&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#595959'&gt;graph, Jira, Confluence (read)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#FF0069;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2016" y="1262" width="210" height="58" as="geometry"/></mxCell>
<mxCell id="b108" value="&lt;b&gt;sa-ai-dev&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#595959'&gt;Git branch + DEV sandbox&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#FF0069;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2238" y="1262" width="210" height="58" as="geometry"/></mxCell>
<mxCell id="b109" value="&lt;b&gt;sa-ai-release&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#595959'&gt;Copado: SIT and UAT only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#FF0069;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2460" y="1262" width="210" height="58" as="geometry"/></mxCell>
<mxCell id="t110" value="&lt;b&gt;No production identity exists for any agent.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=13;fontColor=#FF0069;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2016" y="1330" width="650" height="34" as="geometry"/></mxCell>
<mxCell id="b111" value="&lt;b&gt;Failure and recovery&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;transient error → retry ×3 with backoff, idempotent steps · bad output → schema reject, re-run once, then owner · failed tests → fix loop ≤ 5, then owner · budget breach → pause + escalate · outage → resume from the Firestore checkpoint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#00273B;fontColor=#000000;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2000" y="1408" width="680" height="142" as="geometry"/></mxCell>
<mxCell id="b112" value="&lt;b&gt;Accuracy guard&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;context only from the graph · every claim cites a node and SHA · an uncited claim or an invented dependency is rejected · the agent that builds never approves its own work&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#00273B;fontColor=#000000;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2000" y="1572" width="680" height="114" as="geometry"/></mxCell>
<mxCell id="b113" value="&lt;b&gt;Jira&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;brief posted (01) · status: Ready for Harness → In progress → QA → Done&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2750" y="196" width="590" height="92" as="geometry"/></mxCell>
<mxCell id="b114" value="&lt;b&gt;Confluence&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;design page draft (02) · as-built record (09)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2750" y="304" width="590" height="80" as="geometry"/></mxCell>
<mxCell id="b115" value="&lt;b&gt;Git&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;branch mad/NS-1234 · pull request · commit SHA (03, 04)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2750" y="400" width="590" height="80" as="geometry"/></mxCell>
<mxCell id="b116" value="&lt;b&gt;Salesforce DEV sandbox&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;change deployed, Apex tests run (03)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2750" y="496" width="590" height="80" as="geometry"/></mxCell>
<mxCell id="b117" value="&lt;b&gt;Copado&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;user story · promotion SIT → UAT · Robotic and regression runs (05)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2750" y="592" width="590" height="92" as="geometry"/></mxCell>
<mxCell id="b118" value="&lt;b&gt;Zephyr Scale&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;test cases and results (04, 05)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2750" y="700" width="590" height="80" as="geometry"/></mxCell>
<mxCell id="b119" value="&lt;b&gt;CAB pack&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;generated from the change passport (07)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2750" y="796" width="590" height="80" as="geometry"/></mxCell>
<mxCell id="b120" value="&lt;b&gt;PRODUCTION&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;owning team's pipeline after CAB (08) · no agent credential&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#595959;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2750" y="892" width="590" height="92" as="geometry"/></mxCell>
<mxCell id="b121" value="&lt;b&gt;Harness audit trail · change passport · BigQuery&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;story → source snapshot → design → approvals → commit SHA → test evidence → deployment → outcome&lt;br&gt;one row per event, each hashed with the previous row: tamper-evident&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2750" y="1000" width="590" height="150" as="geometry"/></mxCell>
<mxCell id="b122" value="&lt;b&gt;Back to the user in Codex&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;status of every step, approval links, and links to the brief, design, PR, UAT build and passport&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2750" y="1166" width="590" height="130" as="geometry"/></mxCell>
