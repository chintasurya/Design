<mxCell id="t98" value="&lt;b&gt;Harness tool gateway · MCP · Cloud Run + Open Policy Agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;checks identity · tool · target · approval for the current SHA → runs the action with that identity's credential from Secret Manager → logs the decision to BigQuery&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;fontColor=#000000;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2336" y="1186" width="650" height="64" as="geometry"/></mxCell>
