<mxCell id="t54" value="&lt;b&gt;Harness run loop&lt;/b&gt; · Cloud Workflows, 9 steps&lt;br&gt;&lt;font style='font-size:12px' color='#595959'&gt;try / retry with backoff · callbacks for every gate&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;fontColor=#000000;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1886" y="346" width="380" height="52" as="geometry"/></mxCell>
<mxCell id="b55" value="&lt;b&gt;01 Understand&lt;/b&gt; · Requirements Agent → brief.json" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0FAFE;strokeColor=#0097AD;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1910" y="410" width="350" height="56" as="geometry"/></mxCell>
<mxCell id="b56" value="&lt;b&gt;H1&lt;/b&gt; · product owner / business lead" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFD700;strokeColor=#FFD700;fontColor=#000000;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1910" y="476" width="350" height="40" as="geometry"/></mxCell>
