<mxCell id="t102" value="&lt;b&gt;No production identity exists for any agent.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=13;fontColor=#FF0069;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2336" y="1330" width="650" height="34" as="geometry"/></mxCell>
<mxCell id="b103" value="&lt;b&gt;Failure and recovery&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2B2B2B'&gt;transient error → retry ×3 with backoff, idempotent steps · bad output → schema reject, re-run once, then owner · failed tests → fix loop ≤ 5, then owner · budget breach → pause + escalate · outage → resume from the Firestore checkpoint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#00273B;fontColor=#000000;fontSize=13;fontStyle=0;align=left;verticalAlign=top;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2320" y="1408" width="680" height="142" as="geometry"/></mxCell>
