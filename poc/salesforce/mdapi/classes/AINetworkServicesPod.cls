/**
 * What the Network Services pod actually is, stated once, in one place.
 *
 * The scope used to be inferred entirely from a profile's object permissions.
 * That was wrong for this org in a way no amount of tuning fixes: several of
 * these objects are written by automation, not by people, so the pod profile
 * has no create permission on them and they fell out of scope while being the
 * whole point of the pod. HealthcareFacilityNetwork is the clearest case — it
 * is generated by Apex and by Flow, never typed in by a human, and it is the
 * object most questions are about.
 *
 * So the pod is declared here and the profile becomes a second opinion rather
 * than the authority. Declared names are resolved against the org at export
 * time and anything that does not resolve is reported by name, because a
 * silent miss here is how an object disappears from every answer.
 *
 * Changing the pod is a code change on purpose: it is reviewable in git, it
 * carries the reason in the diff, and it cannot drift without someone seeing
 * it happen.
 */
public with sharing class AINetworkServicesPod {

    /**
     * The objects the pod owns, as the pod owner named them.
     *
     * These are logical names, not necessarily API names. Resolution is
     * normalized — case, spaces, underscores and a trailing __c are all
     * ignored — so "Credentialing Application" matches
     * Credentialing_Application__c and "HealthcareFacilityNetwork" matches
     * HealthcareFacilityNetwork__c or the standard object of that name,
     * whichever this org actually has. Whichever it is, the export reports
     * what each one resolved to.
     */
    public static final List<String> OBJECTS = new List<String>{
        // The chain: Account creates a provider, a provider has facilities,
        // facilities have practitioners and specialities, and an agreement
        // signs at the end of it. A child account runs the same chain again.
        'Account',
        'HealthcareProvider',
        'HealthcareFacility',
        'HealthcarePractitionerFacility',
        'CareProviderFacilitySpecialty',
        'ContractPaymentAgreement',

        // HFN. Generated, never typed, and the subject of most questions.
        'HealthcareFacilityNetwork',

        // Named by the pod owner as in scope alongside the chain.
        'Lead',
        'Contact',
        'Opportunity',
        'Task',
        'Case',
        'CredentialingApplication'
    };

    /**
     * Objects the pod owns but does not create by hand.
     *
     * Kept separate only so the scope note can say why they are here. The
     * profile has no create permission on these; automation makes them. Using
     * create access as the ownership signal is exactly what hid them.
     */
    public static final Set<String> CREATED_BY_AUTOMATION = new Set<String>{
        'HealthcareFacilityNetwork',
        'HealthcarePractitionerFacility',
        'CareProviderFacilitySpecialty',
        'ContractPaymentAgreement'
    };

    /**
     * Record type names that mean "this record belongs to Network Services".
     *
     * Matched against a normalized DeveloperName, so "Network Services TX CIN"
     * is caught by the first token as well. The previous code matched the bare
     * word "network", which would also have caught an unrelated Network
     * Partner or Network Ops record type.
     */
    public static final List<String> RECORD_TYPE_TOKENS = new List<String>{
        'networkservices'
    };

    /**
     * How the pod names its automation.
     *
     * Flows and Apex belonging to the pod are prefixed. This matters because
     * an object link is not always resolvable — a screen flow or a subflow has
     * no trigger object at all — and the name is then the only signal that a
     * component is the pod's. Matched against a normalized name, so
     * "Network Services HFN Generation", "NS_HFN_Generation" and
     * "AHC_AccountTriggerHandler" all match.
     */
    public static final List<String> AUTOMATION_PREFIXES = new List<String>{
        'networkservices',
        'ns',
        'ahc'
    };

    /**
     * The triggers the pod enters through.
     *
     * Named explicitly because they are the roots of the call chains that
     * answer most questions: a question about what happens to an Account ends
     * up inside AHC_AccountTrigger's handler, and its handlers' handlers.
     */
    public static final List<String> ENTRY_TRIGGERS = new List<String>{
        'AHC_AccountTrigger',
        'AHC_LeadTrigger'
    };

    /**
     * Objects whose field list must be trimmed rather than taken whole.
     *
     * These carry hundreds of fields each, most belonging to other pods. The
     * pod's own data lives in custom fields, so those are taken first and the
     * standard ones fill whatever budget is left.
     *
     * This is an approximation of what was actually asked for, which was
     * fields by record type access. Record type to field visibility runs
     * through page layout assignments, which describe() does not expose and
     * which need the Metadata API. Saying "custom fields first" is honest
     * about being a proxy; claiming record type filtering would not be.
     */
    public static final Set<String> TRIM_FIELDS_ON = new Set<String>{
        'account', 'contact', 'lead', 'opportunity', 'case', 'task'
    };

    /** True when a component name looks like it belongs to the pod. */
    public static Boolean namedForPod(String componentName) {
        if (String.isBlank(componentName)) {
            return false;
        }
        String flat = normalize(componentName);
        for (String prefix : AUTOMATION_PREFIXES) {
            if (flat.startsWith(prefix)) {
                return true;
            }
        }
        for (String entryTrigger : ENTRY_TRIGGERS) {
            if (flat == normalize(entryTrigger)) {
                return true;
            }
        }
        return false;
    }

    /** True when a record type DeveloperName marks a pod record. */
    public static Boolean podRecordType(String developerName) {
        String flat = normalize(developerName);
        for (String token : RECORD_TYPE_TOKENS) {
            if (flat.contains(token)) {
                return true;
            }
        }
        return false;
    }

    /**
     * Resolve the declared object names against what the org actually has.
     *
     * Returns API name by declared name for everything that resolved. What
     * did not resolve is the caller's to report: a typo or a renamed object
     * must be visible, not swallowed.
     */
    public static Map<String, String> resolveObjects(
            Map<String, String> orgByNormalizedName) {
        Map<String, String> resolved = new Map<String, String>();
        for (String declared : OBJECTS) {
            String apiName = orgByNormalizedName.get(normalize(declared));
            if (apiName != null) {
                resolved.put(declared, apiName);
            }
        }
        return resolved;
    }

    public static String normalize(String value) {
        return value == null
            ? ''
            : value.toLowerCase().replaceAll('[^a-z0-9]', '');
    }
}
